<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight export with MANUAL distribution signing. Headless
	     automatic signing can't archive here (it wants a Development profile,
	     which needs a registered device), so we sign with the account's Apple
	     Distribution cert + the "Chawan App Store" profile — same pattern as Buffy. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>ZCS5Y23P62</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.mark.chawan</key>
		<string>Chawan App Store</string>
	</dict>
	<key>destination</key>
	<string>export</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
